        <mxCell id="gnbgyJkMhnsvMxeIZPOV-27" value="Игрок ставит специальные ловушки только для данного типа врагов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
