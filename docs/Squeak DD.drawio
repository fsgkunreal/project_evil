          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gnbgyJkMhnsvMxeIZPOV-29" value="Зло не может поймать Человека. Ночь пройдена." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="214" y="640" width="120" height="80" as="geometry" />
        </mxCell>
